#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    double x1, y1, x2, y2, x3, y3;

    cout << "=== Обчислення площі трикутника за координатами вершин ===\n";
    cout << "Введіть координати вершини A (x1 y1): ";
    cin >> x1 >> y1;
    cout << "Введіть координати вершини B (x2 y2): ";
    cin >> x2 >> y2;
    cout << "Введіть координати вершини C (x3 y3): ";
    cin >> x3 >> y3;

    double S = fabs(x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2)) / 2.0;

    if (S == 0)
    {
        cout << "\nУвага: площа дорівнює 0 - точки лежать на одній прямій "
                "(не утворюють трикутник)!\n";
    }
    else
    {
        cout << "\nПлоща трикутника S = " << S << "\n";
    }

    return 0;
}
